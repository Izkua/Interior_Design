<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Launch screen: the app's background color (matches Theme.background). -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<!-- interiordesign:// links open the app: sign-in callbacks and email confirmation. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Sign-in callback</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>interiordesign</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
